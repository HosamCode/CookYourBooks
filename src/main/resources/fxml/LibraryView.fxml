<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  Library View — browse and manage recipe collections.

  Layout:
    Top    : filter field + Refresh / Create / Delete buttons
    Center : collections list (left) | recipes list (right)
    Bottom : loading indicator + undo bar (each hidden when not needed)
-->
<BorderPane xmlns:fx="http://javafx.com/fxml" styleClass="library-view">

    <top>
        <VBox spacing="8">
            <padding>
                <Insets bottom="8"/>
            </padding>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="filterTextField"
                           promptText="Filter collections…"
                           HBox.hgrow="ALWAYS"/>
                <Button fx:id="refreshButton" text="Refresh"/>
                <Button fx:id="createButton" text="Create"/>
                <Button fx:id="deleteButton" text="Delete"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="8">
            <ListView fx:id="collectionsListView" HBox.hgrow="ALWAYS"/>
            <ListView fx:id="recipesListView" HBox.hgrow="ALWAYS"/>
        </HBox>
    </center>

    <bottom>
        <VBox spacing="4">
            <padding>
                <Insets top="8"/>
            </padding>

            <!-- Loading indicator: visible and managed are both bound to loadingProperty() -->
            <ProgressIndicator fx:id="loadingIndicator"
                               maxWidth="Infinity"
                               prefHeight="24"/>

            <!-- Undo bar: visible and managed are both bound to undoAvailableProperty() -->
            <HBox fx:id="undoBar" spacing="8" alignment="CENTER_LEFT">
                <Label fx:id="undoMessageLabel"/>
                <Button fx:id="undoButton" text="Undo"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
