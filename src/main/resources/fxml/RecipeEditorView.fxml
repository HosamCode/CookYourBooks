<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
    fx:controller="app.cookyourbooks.gui.view.RecipeEditorViewController"
    spacing="0"
    fillWidth="true"
    maxWidth="Infinity"
    maxHeight="Infinity"
    style="-fx-background-color: white; -fx-effect: null; -fx-border-width: 0;">

    <!-- ── Top bar ── -->
    <HBox alignment="CENTER_LEFT" spacing="8"
        style="-fx-background-color: #2c3e50; -fx-padding: 10 16 10 16;">
        <Label text="Recipe Editor"
            style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;"
            HBox.hgrow="ALWAYS" />
        <HBox HBox.hgrow="ALWAYS" />
        <Button fx:id="editButton" text="Edit" onAction="#onEdit"
            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 4; -fx-cursor: hand;" />
        <Button fx:id="saveButton" text="Save" onAction="#onSave"
            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 4; -fx-cursor: hand;" />
        <Button fx:id="discardButton" text="Discard" onAction="#onDiscard"
            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 4; -fx-cursor: hand;" />
        <Button fx:id="exportPdfButton" text="Export PDF" onAction="#onExportPdf"
            style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-background-radius: 4; -fx-cursor: hand;" />
    </HBox>

    <Separator />

    <!-- ── Recipe Title ── -->
    <VBox spacing="8" style="-fx-padding: 16 16 8 16;">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Recipe Title"
                style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                minWidth="100" />
            <TextField fx:id="titleField"
                promptText="Enter recipe title"
                HBox.hgrow="ALWAYS"
                maxWidth="Infinity" />
        </HBox>
    </VBox>

    <Separator />

    <!-- ── Recipe Scaling ── -->
    <VBox spacing="8" style="-fx-padding: 12 16 12 16; -fx-background-color: #f0f7ff;">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Scale Recipe"
                style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                minWidth="100" />
            <Label text="Servings:"
                style="-fx-text-fill: #2c3e50;" />
            <TextField fx:id="servingsField"
                promptText="e.g. 4"
                prefWidth="70" />
            <Button fx:id="scaleButton" text="Scale" onAction="#onScale"
                style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-background-radius: 4; -fx-cursor: hand;" />
            <Label fx:id="scaleStatusLabel"
                style="-fx-text-fill: #7f8c8d; -fx-font-size: 12;" />
        </HBox>
    </VBox>

    <Separator />

    <!-- ── Ingredients | Instructions ── -->
    <HBox spacing="0" VBox.vgrow="ALWAYS">

        <!-- Ingredients column -->
        <VBox spacing="8" HBox.hgrow="ALWAYS"
            style="-fx-padding: 12; -fx-border-color: #ecf0f1; -fx-border-width: 0 1 0 0;">
            <Label text="Ingredients"
                style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
            <ListView fx:id="ingredientList"
                VBox.vgrow="ALWAYS"
                maxWidth="Infinity" />
            <HBox spacing="8">
                <Button fx:id="addIngredientButton"
                    text="+ Add Ingredient"
                    onAction="#onAddIngredient"
                    style="-fx-background-color: #ecf0f1; -fx-text-fill: #2c3e50; -fx-background-radius: 4; -fx-cursor: hand;" />
                <Button fx:id="removeIngredientButton"
                    text="✕ Remove"
                    onAction="#onRemoveIngredient"
                    style="-fx-background-color: #ecf0f1; -fx-text-fill: #e74c3c; -fx-background-radius: 4; -fx-cursor: hand;" />
            </HBox>
        </VBox>

        <!-- Instructions column -->
        <VBox spacing="8" HBox.hgrow="ALWAYS"
            style="-fx-padding: 12;">
            <Label text="Instructions"
                style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
            <ListView fx:id="instructionList"
                VBox.vgrow="ALWAYS"
                maxWidth="Infinity" />
        </VBox>

    </HBox>

    <Separator />

    <!-- ── Status bar ── -->
    <HBox style="-fx-padding: 8 16 8 16; -fx-background-color: #f8f9fa;">
        <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12;" />
    </HBox>

</VBox>